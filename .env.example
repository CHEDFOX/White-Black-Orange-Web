# Backend API base URL. Read server-side only: every request from the browser
# goes to this app's own route handlers, which proxy to the backend, so the
# backend address and any API key never reach a browser bundle.
API_BASE_URL=http://localhost:8000/api/v1

# Optional backend API key, when the backend sets REQUIRE_API_KEY=true.
# API_KEY=

# Request timeout for backend calls, in milliseconds. Analysis and
# walk-forward endpoints can legitimately take tens of seconds.
API_TIMEOUT_MS=120000
